<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Final A1 English Test — ARVA by Kat</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
  :root{
    --orange:#ff751f;
    --orange-dark:#e5620f;
    --pink:#fa1f43;
    --gray:#545454;
    --cream:#fff8f1;
    --card:#ffffff;
    --line:#ece5dd;
    --radius:16px;
  }
  *{box-sizing:border-box;}
  html,body{margin:0;padding:0;}
  body{
    font-family:'Inter',sans-serif;
    background:var(--cream);
    color:var(--gray);
    line-height:1.5;
    -webkit-font-smoothing:antialiased;
  }
  h1,h2,h3,.display{font-family:'Poppins',sans-serif;}
  .app{max-width:760px;margin:0 auto;padding-bottom:80px;}
  .banner{width:100%;display:block;}
  .banner img{width:100%;display:block;}

  .screen{display:none;padding:0 24px;}
  .screen.active{display:block;}

  .welcome-inner{padding-top:36px;}
  .headline{
    color:var(--pink);
    font-size:1.7rem;
    font-weight:800;
    text-align:center;
    margin:8px 0 28px;
    letter-spacing:-0.01em;
  }
  .card{
    background:var(--card);
    border:1px solid var(--line);
    border-radius:var(--radius);
    padding:24px;
    margin-bottom:18px;
    box-shadow:0 2px 14px rgba(84,84,84,0.06);
  }
  .name-prompt{font-size:1.05rem;font-weight:600;color:var(--gray);margin-bottom:14px;}
  input[type="text"]{
    width:100%;
    padding:12px 14px;
    border:2px solid var(--line);
    border-radius:10px;
    font-size:1rem;
    font-family:'Inter',sans-serif;
    color:var(--gray);
    outline:none;
    transition:border-color .15s ease;
  }
  input[type="text"]:focus{border-color:var(--orange);}
  input[type="text"]:disabled{background:#f4f9f0;color:#3d8b3d;border-color:#bfe3bf;font-weight:600;}

  .btn{
    display:inline-block;
    background:var(--orange);
    color:#fff;
    font-family:'Poppins',sans-serif;
    font-weight:700;
    font-size:1rem;
    border:none;
    border-radius:999px;
    padding:14px 30px;
    cursor:pointer;
    text-align:center;
    text-decoration:none;
    transition:transform .12s ease, background .15s ease;
    letter-spacing:.02em;
  }
  .btn:hover{background:var(--orange-dark);transform:translateY(-1px);}
  .btn:disabled{background:#e8bfa1;cursor:not-allowed;transform:none;}
  .btn-row{display:flex;justify-content:center;margin-top:24px;}
  .btn-secondary{
    background:#fff;color:var(--orange);border:2px solid var(--orange);
  }
  .btn-secondary:hover{background:#fff3ea;}

  .progress-wrap{margin-top:22px;display:none;}
  .progress-wrap.show{display:block;}
  .progress-track{
    width:100%;height:10px;border-radius:999px;background:#f1ded0;overflow:hidden;
  }
  .progress-fill{
    height:100%;width:0%;background:linear-gradient(90deg,var(--orange),var(--pink));
    border-radius:999px;transition:width 1.1s cubic-bezier(.2,.8,.2,1);
  }
  .progress-label{text-align:center;font-size:.85rem;color:var(--gray);margin-top:8px;font-weight:600;}

  .section-title{
    display:flex;align-items:center;gap:10px;
    font-size:1.4rem;font-weight:800;color:var(--gray);margin:28px 0 6px;
  }
  .section-sub{color:var(--gray);opacity:.85;margin-bottom:18px;font-size:.95rem;}

  .video-wrap{position:relative;width:100%;padding-top:56.25%;border-radius:var(--radius);overflow:hidden;margin-bottom:22px;box-shadow:0 2px 14px rgba(84,84,84,0.1);}
  .video-wrap iframe{position:absolute;top:0;left:0;width:100%;height:100%;border:0;}
  .video-link{
    position:absolute;top:0;left:0;width:100%;height:100%;
    display:block;background:#111 center/cover no-repeat;
    text-decoration:none;
  }
  .video-link .play-badge{
    position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);
    width:74px;height:74px;border-radius:50%;
    background:rgba(255,117,31,0.92);
    display:flex;align-items:center;justify-content:center;
    box-shadow:0 4px 18px rgba(0,0,0,0.35);
    transition:transform .15s ease, background .15s ease;
  }
  .video-link:hover .play-badge{transform:translate(-50%,-50%) scale(1.08);background:var(--pink);}
  .video-link .play-badge svg{width:26px;height:26px;margin-left:4px;}
  .video-link .video-caption{
    position:absolute;left:0;right:0;bottom:0;padding:14px 18px;
    background:linear-gradient(0deg,rgba(0,0,0,0.65),transparent);
    color:#fff;font-weight:700;font-size:.92rem;
  }

  .tag{
    display:inline-block;background:var(--pink);color:#fff;font-weight:700;
    font-size:.78rem;padding:4px 10px;border-radius:999px;margin-bottom:10px;
  }

  .q-block{margin-bottom:20px;}
  .q-title{font-weight:700;color:var(--gray);margin-bottom:8px;font-size:.98rem;}
  .q-italic{font-style:italic;color:var(--gray);opacity:.85;font-size:.92rem;margin-bottom:6px;}
  .table-form{width:100%;border-collapse:collapse;margin-bottom:8px;}
  .table-form td{border:1px solid var(--line);padding:10px 12px;font-size:.94rem;}
  .table-form td.label{background:#fff4ea;font-weight:700;width:42%;}
  .table-form input[type=text]{padding:8px 10px;font-size:.94rem;}

  .checkbox-row,.radio-row{
    display:flex;align-items:center;gap:10px;padding:8px 10px;border:1px solid var(--line);
    border-radius:10px;margin-bottom:8px;cursor:pointer;transition:border-color .12s ease, background .12s ease;
  }
  .checkbox-row:hover,.radio-row:hover{border-color:var(--orange);background:#fff8f2;}
  .checkbox-row.correct,.radio-row.correct{border-color:#3d8b3d;background:#f4f9f0;}
  .checkbox-row.wrong,.radio-row.wrong{border-color:var(--pink);background:#fff0f2;}
  .checkbox-row input,.radio-row input{width:17px;height:17px;accent-color:var(--orange);flex-shrink:0;}

  .locked-badge{
    display:inline-block;font-size:.75rem;font-weight:700;color:#3d8b3d;
    background:#e7f5e7;padding:3px 9px;border-radius:999px;margin-left:8px;
  }
  .fix-badge{
    display:inline-block;font-size:.75rem;font-weight:700;color:var(--pink);
    background:#ffe4e9;padding:3px 9px;border-radius:999px;margin-left:8px;
  }

  .reading-grid{display:flex;gap:18px;margin-top:6px;}
  .reading-col{
    flex:1;min-width:0;border:1px solid var(--line);border-radius:var(--radius);
    background:var(--card);padding:18px;max-height:560px;overflow-y:auto;
  }
  .reading-col img{width:100%;border-radius:10px;margin-bottom:14px;object-fit:cover;max-height:200px;}
  .reading-col h3{color:var(--gray);font-size:1.15rem;margin:6px 0 12px;line-height:1.25;}
  .reading-col p{font-size:.92rem;color:var(--gray);margin-bottom:12px;}
  @media (max-width:640px){
    .reading-grid{flex-direction:column;}
    .reading-col{max-height:none;}
  }

  .part-header{
    font-weight:800;color:#fff;background:var(--gray);display:inline-block;
    padding:6px 14px;border-radius:8px;font-size:.9rem;margin:24px 0 14px;
  }
  .part-header.p2{background:#3d8b3d;}
  .part-header.p3{background:var(--orange);}

  .strike{color:var(--pink);font-weight:600;}
  .check{color:#3d8b3d;font-weight:600;}

  .score-screen{text-align:center;padding-top:26px;}
  .score-big{
    font-family:'Poppins',sans-serif;font-weight:800;font-size:4rem;color:var(--orange);
    margin:14px 0 4px;line-height:1;
  }
  .score-sub{color:var(--gray);font-weight:600;margin-bottom:24px;}
  .section-scores{
    display:flex;gap:12px;justify-content:center;flex-wrap:wrap;
    max-width:560px;margin:0 auto 22px;
  }
  .section-score-card{
    flex:1;min-width:140px;border:2px solid var(--line);border-radius:14px;
    padding:14px 12px;background:#fff;
  }
  .section-score-card .ssc-label{font-size:.82rem;font-weight:700;color:var(--gray);opacity:.8;margin-bottom:4px;}
  .section-score-card .ssc-value{font-family:'Poppins',sans-serif;font-weight:800;font-size:1.5rem;color:var(--gray);}
  .section-score-card .ssc-frac{font-size:.78rem;color:var(--gray);opacity:.75;}
  .section-score-card.best{
    border-color:#3d8b3d;background:#f0f9f0;
  }
  .section-score-card.best .ssc-value{color:#2e7d32;}
  .section-score-card.best .ssc-label{color:#2e7d32;}
  .finish-msg{font-size:1rem;color:var(--gray);text-align:left;margin:18px 0;}
  .finish-msg p{margin:0 0 12px;}

  footer.tiny{text-align:center;color:#b8907a;font-size:.78rem;margin-top:26px;}
</style>
</head>
<body>

<div class="app">
  <div class="banner"><img src="data:image/png;base64," alt="Final A1 Test — ARVA by Kat"></div>

  <!-- WELCOME -->
  <div class="screen active" id="screen-welcome">
    <div class="welcome-inner">
      <h1 class="headline">Welcome to Your Final A1 English Test!</h1>
      <div class="card">
        <div class="name-prompt">🤔 What is your name?</div>
        <input type="text" id="nameInput" placeholder="Type your name here...">
      </div>
      <div class="btn-row">
        <button class="btn" id="btnNameNext" disabled>Continue</button>
      </div>
    </div>
  </div>

  <!-- INTRO / HI -->
  <div class="screen" id="screen-intro">
    <div class="card" style="margin-top:28px;">
      <h2 style="margin-top:0;color:var(--gray);">👋 Hi <span id="helloName" style="color:var(--orange);"></span></h2>
      <p>Ready para poner tu English a prueba? 🔥</p>
      <p>Vamos a poner a prueba tu listening, reading and grammar que aprendiste en este nivel 👀.</p>
      <p><strong>The test has 35 questions divided into 3 sections: Listening, Reading and Grammar. You need an overall score of 70% to pass.</strong></p>
    </div>
    <div class="btn-row">
      <button class="btn" id="btnLetsGo">LET'S GO!</button>
    </div>
    <div class="progress-wrap" id="progressWrap">
      <div class="progress-track"><div class="progress-fill" id="progressFill"></div></div>
      <div class="progress-label">Getting your test ready...</div>
    </div>
  </div>

  <!-- LISTENING -->
  <div class="screen" id="screen-listening">
    <div class="section-title">🎧 Listening</div>
    <p class="section-sub"><strong>Para esta prueba necesitas estar en un lugar silencioso y preferiblemente usar audífonos para escuchar mejor los audios.</strong></p>
    <div class="video-wrap">
      <a class="video-link" href="https://youtu.be/spR66-hT_DQ" target="_blank" rel="noopener"
         style="background-image:url('https://img.youtube.com/vi/spR66-hT_DQ/hqdefault.jpg');">
        <span class="play-badge">
          <svg viewBox="0 0 24 24" fill="#fff"><path d="M8 5v14l11-7z"/></svg>
        </span>
        <span class="video-caption">▶ ARVA Test — A1 Listening · Watch on YouTube</span>
      </a>
    </div>

    <div class="card">
      <span class="tag">The International Student</span>
      <p style="margin:0;"><strong>Analiza primero el test antes de escuchar el listening. Usa solo MAYÚSCULAS para responder el test.</strong></p>
    </div>

    <h3>Questions 1–5</h3>
    <p class="q-italic">The housing officer takes some details from the girl.<br>
    Ayuda al asesor a completar el formulario de información de la estudiante de intercambio</p>
    <p style="font-weight:700;color:var(--pink);font-size:.88rem;">NO MORE THAN THREE WORDS AND/OR A NUMBER for each answer.</p>

    <table class="table-form" id="listeningTable1">
      <tr><td class="label">First name</td><td>1. <input type="text" data-q="l1" placeholder="Answer"></td></tr>
      <tr><td class="label">Family name</td><td>Yuichini</td></tr>
      <tr><td class="label">Gender</td><td>Female</td></tr>
      <tr><td class="label">Age</td><td>28</td></tr>
      <tr><td class="label">Passport number</td><td>2. <input type="text" data-q="l2" placeholder="Answer"></td></tr>
      <tr><td class="label">Nationality</td><td>Japanese</td></tr>
      <tr><td class="label">Course enrolled</td><td>3. <input type="text" data-q="l3" placeholder="Answer"></td></tr>
      <tr><td class="label">Length of the course</td><td>4. <input type="text" data-q="l4" placeholder="Answer"></td></tr>
      <tr><td class="label">Homestay time</td><td>5. <input type="text" data-q="l5" placeholder="Answer"></td></tr>
    </table>

    <div class="q-block">
      <div class="q-title">Question 6 — Mark TWO letters that represent the correct answer.<br>Which TWO things does the girl prefer in her host family?</div>
      <label class="checkbox-row"><input type="checkbox" data-q="l6" value="A"> A. A big family with many young children</label>
      <label class="checkbox-row"><input type="checkbox" data-q="l6" value="B"> B. A family without smokers or drinkers</label>
      <label class="checkbox-row"><input type="checkbox" data-q="l6" value="C"> C. A family without any pets</label>
      <label class="checkbox-row"><input type="checkbox" data-q="l6" value="D"> D. A family with many animals or pets</label>
    </div>

    <h3>Questions 7–10</h3>
    <p class="q-italic">Fill in the blanks with NO MORE THAN THREE WORDS for each answer.</p>
    <div class="q-block"><div class="q-title">The girl is not vegetarian and she doesn't eat a lot of meat. Her favourite food is 7. <input type="text" data-q="l7" style="width:220px;display:inline-block;" placeholder="Answer"></div></div>
    <div class="q-block"><div class="q-title">The girl used to play handball but now, she just plays 8. <input type="text" data-q="l8" style="width:220px;display:inline-block;" placeholder="Answer"> with her friends at weekends.</div></div>
    <div class="q-block"><div class="q-title">The girl does not like the bus because they are always late. She prefers to take 9. <input type="text" data-q="l9" style="width:220px;display:inline-block;" placeholder="Answer"></div></div>
    <div class="q-block"><div class="q-title">The information about her host family will be ready 10. <input type="text" data-q="l10" style="width:220px;display:inline-block;" placeholder="Answer"></div></div>

    <div class="btn-row"><button class="btn" id="btnToReading">NEXT</button></div>
  </div>

  <!-- READING -->
  <div class="screen" id="screen-reading">
    <div class="section-title">📖 Reading</div>
    <p class="section-sub">Esta sección tiene 10 preguntas, para las preguntas de completar usa el teclado en MAYÚSCULAS siempre.</p>

    <div class="reading-grid">
      <div class="reading-col">
        <img src="https://images.unsplash.com/photo-1611523658822-385aa008324c?w=600&q=80" alt="Tom Holland" onerror="this.style.display='none'">
        <h3>Tom Holland – The King of Manifestation</h3>
        <p>Have you ever asked the world for something you really wanted… and actually got it? Some people call it luck, others call it destiny, but we call it manifesting. Manifesting is the idea that you focus on what you want, believe in it, and take action to make it happen. If you think this is just some magic idea that Gen Z believes in, think again! Let's talk about Tom Holland, the British actor and, according to his fans, the <em>King of Manifestation</em>. Before he became Spider-Man, Tom took ballet and gymnastics classes. These skills helped him get the role. But Spider-Man was not the only dream he has achieved!</p>
        <p>Tom has talked about many things he wanted in his career, and some of them have happened. He wanted to play Spider-Man, and in 2015 he got the role. He has also said that he wanted to work with famous actors, and his career has given him many opportunities. But here is the fun part: Tom has talked about Zendaya, too. Before they became a couple, Tom said in an interview that he had a crush on her. Later, they worked together on <em>Spider-Man</em>, and their friendship became a relationship. Coincidence or manifestation? You decide!</p>
        <p>So, has Tom Holland really mastered manifestation? Maybe we will never know! What we do know is that he has worked hard, followed his dreams, and taken opportunities. Maybe manifestation is not magic after all. Maybe it is about knowing what you want and doing something to achieve it. What about you? Have you ever manifested something that actually happened?</p>
      </div>

      <div class="reading-col">
        <h3 style="font-size:1.05rem;">Questions</h3>

        <div class="q-block"><div class="q-title">1. Complete the sentence.<br>Tom Holland is a <input type="text" data-q="r1" style="width:150px;display:inline-block;" placeholder="answer"> actor.</div></div>

        <div class="q-block"><div class="q-title">2. Complete the sentence.<br>Before becoming Spider-Man, Tom took <input type="text" data-q="r2" style="width:150px;display:inline-block;" placeholder="answer"> and gymnastics classes.</div></div>

        <div class="q-block">
          <div class="q-title">3. True or False. Tom got the role of Spider-Man in 2015.</div>
          <label class="radio-row"><input type="radio" name="r3" data-q="r3" value="TRUE"> TRUE</label>
          <label class="radio-row"><input type="radio" name="r3" data-q="r3" value="FALSE"> FALSE</label>
        </div>

        <div class="q-block">
          <div class="q-title">4. True or False. Tom and Zendaya worked together on Spider-Man.</div>
          <label class="radio-row"><input type="radio" name="r4" data-q="r4" value="TRUE"> TRUE</label>
          <label class="radio-row"><input type="radio" name="r4" data-q="r4" value="FALSE"> FALSE</label>
        </div>

        <div class="q-block">
          <div class="q-title">5. True or False. The text says that manifestation is definitely magic.</div>
          <label class="radio-row"><input type="radio" name="r5" data-q="r5" value="TRUE"> TRUE</label>
          <label class="radio-row"><input type="radio" name="r5" data-q="r5" value="FALSE"> FALSE</label>
        </div>

        <div class="q-block">
          <div class="q-title">6. What is manifestation according to the text?</div>
          <label class="radio-row"><input type="radio" name="r6" data-q="r6" value="A"> A. Waiting for good luck</label>
          <label class="radio-row"><input type="radio" name="r6" data-q="r6" value="B"> B. Focusing on what you want and taking action</label>
          <label class="radio-row"><input type="radio" name="r6" data-q="r6" value="C"> C. Becoming famous</label>
          <label class="radio-row"><input type="radio" name="r6" data-q="r6" value="D"> D. Learning magic</label>
        </div>

        <div class="q-block">
          <div class="q-title">7. Why did Tom's ballet and gymnastics classes help him?</div>
          <label class="radio-row"><input type="radio" name="r7" data-q="r7" value="A"> A. They helped him get the Spider-Man role.</label>
          <label class="radio-row"><input type="radio" name="r7" data-q="r7" value="B"> B. They helped him meet Zendaya.</label>
          <label class="radio-row"><input type="radio" name="r7" data-q="r7" value="C"> C. They made him a singer.</label>
          <label class="radio-row"><input type="radio" name="r7" data-q="r7" value="D"> D. They helped him become a director.</label>
        </div>

        <div class="q-block">
          <div class="q-title">8. What did Tom say about Zendaya before they became a couple?</div>
          <label class="radio-row"><input type="radio" name="r8" data-q="r8" value="A"> A. He was her teacher.</label>
          <label class="radio-row"><input type="radio" name="r8" data-q="r8" value="B"> B. He had a crush on her.</label>
          <label class="radio-row"><input type="radio" name="r8" data-q="r8" value="C"> C. He wanted to work for her.</label>
          <label class="radio-row"><input type="radio" name="r8" data-q="r8" value="D"> D. He didn't know her.</label>
        </div>

        <div class="q-block"><div class="q-title">9. Complete the sentence.<br>Tom has <input type="text" data-q="r9" style="width:150px;display:inline-block;" placeholder="answer"> hard and followed his dreams.</div></div>

        <div class="q-block">
          <div class="q-title">10. What is the main purpose of the text?</div>
          <label class="radio-row"><input type="radio" name="r10" data-q="r10" value="A"> A. To teach people how to manifest what they want.</label>
          <label class="radio-row"><input type="radio" name="r10" data-q="r10" value="B"> B. To demonstrate how manifestation may work, using Tom Holland as an example.</label>
          <label class="radio-row"><input type="radio" name="r10" data-q="r10" value="C"> C. To tell the story of Tom Holland's career.</label>
          <label class="radio-row"><input type="radio" name="r10" data-q="r10" value="D"> D. To explain that manifestation is not magic but a conscious process.</label>
        </div>
      </div>
    </div>

    <div class="btn-row"><button class="btn" id="btnToGrammar">NEXT</button></div>
  </div>

  <!-- GRAMMAR -->
  <div class="screen" id="screen-grammar">
    <div class="section-title">🧠 Grammar</div>

    <div class="part-header">Part 1 — Multiple Choice</div>

    <div class="q-block">
      <div class="q-title">1. I usually _______ coffee in the morning, but today I _______ tea.</div>
      <label class="radio-row"><input type="radio" name="g1" data-q="g1" value="A"> A. drink / am having</label>
      <label class="radio-row"><input type="radio" name="g1" data-q="g1" value="B"> B. am drinking / have</label>
      <label class="radio-row"><input type="radio" name="g1" data-q="g1" value="C"> C. drinks / have</label>
      <label class="radio-row"><input type="radio" name="g1" data-q="g1" value="D"> D. am drinking / am having</label>
    </div>

    <div class="q-block">
      <div class="q-title">2. _______ you ever _______ a famous person?</div>
      <label class="radio-row"><input type="radio" name="g2" data-q="g2" value="A"> A. Did / meet</label>
      <label class="radio-row"><input type="radio" name="g2" data-q="g2" value="B"> B. Have / met</label>
      <label class="radio-row"><input type="radio" name="g2" data-q="g2" value="C"> C. Are / meeting</label>
      <label class="radio-row"><input type="radio" name="g2" data-q="g2" value="D"> D. Have / meet</label>
    </div>

    <div class="q-block">
      <div class="q-title">3. We went to the beach _______ Sunday, but we arrived _______ 8:30 a.m.</div>
      <label class="radio-row"><input type="radio" name="g3" data-q="g3" value="A"> A. at / on</label>
      <label class="radio-row"><input type="radio" name="g3" data-q="g3" value="B"> B. on / at</label>
      <label class="radio-row"><input type="radio" name="g3" data-q="g3" value="C"> C. in / at</label>
      <label class="radio-row"><input type="radio" name="g3" data-q="g3" value="D"> D. on / in</label>
    </div>

    <div class="q-block">
      <div class="q-title">4. My new apartment is _______ than my old one, but the old apartment was _______ place in the neighborhood.</div>
      <label class="radio-row"><input type="radio" name="g4" data-q="g4" value="A"> A. more comfortable / the cheapest</label>
      <label class="radio-row"><input type="radio" name="g4" data-q="g4" value="B"> B. comfortabler / cheaper</label>
      <label class="radio-row"><input type="radio" name="g4" data-q="g4" value="C"> C. most comfortable / the cheaper</label>
      <label class="radio-row"><input type="radio" name="g4" data-q="g4" value="D"> D. more comfortable / cheapest</label>
    </div>

    <div class="q-block">
      <div class="q-title">5. I _______ this movie before, but I _______ it again last night with my friends.</div>
      <label class="radio-row"><input type="radio" name="g5" data-q="g5" value="A"> A. saw / have watched</label>
      <label class="radio-row"><input type="radio" name="g5" data-q="g5" value="B"> B. have seen / watched</label>
      <label class="radio-row"><input type="radio" name="g5" data-q="g5" value="C"> C. have seen / have watched</label>
      <label class="radio-row"><input type="radio" name="g5" data-q="g5" value="D"> D. see / watched</label>
    </div>

    <div class="part-header p2">Part 2 — Fill in the Blank</div>
    <div class="q-block"><div class="q-title">6. I <input type="text" data-q="g6" style="width:220px;display:inline-block;" placeholder="not / see"> John since last Monday.</div></div>
    <div class="q-block"><div class="q-title">7. Look! The children <input type="text" data-q="g7" style="width:220px;display:inline-block;" placeholder="play"> in the garden.</div></div>
    <div class="q-block"><div class="q-title">8. My parents <input type="text" data-q="g8" style="width:220px;display:inline-block;" placeholder="visit"> Bogotá last weekend.</div></div>
    <div class="q-block"><div class="q-title">9. We usually have our English class <input type="text" data-q="g9a" style="width:110px;display:inline-block;" placeholder="in/at"> the morning, but today we're meeting <input type="text" data-q="g9b" style="width:110px;display:inline-block;" placeholder="in/at"> 7:00 p.m.</div></div>
    <div class="q-block"><div class="q-title">10. This is <input type="text" data-q="g10" style="width:260px;display:inline-block;" placeholder="interesting"> book I have ever read.</div></div>

    <div class="part-header p3">Part 3 — Correct the Phrase</div>
    <div class="q-block"><div class="q-title">11. <span class="strike">❌ She is usually go to the gym after work.</span></div><input type="text" data-q="g11" placeholder="✅ Your correction"></div>
    <div class="q-block"><div class="q-title">12. <span class="strike">❌ I have visited Cartagena last year.</span></div><input type="text" data-q="g12" placeholder="✅ Your correction"></div>
    <div class="q-block"><div class="q-title">13. <span class="strike">❌ They are living in this apartment since 2023.</span></div><input type="text" data-q="g13" placeholder="✅ Your correction"></div>
    <div class="q-block"><div class="q-title">14. <span class="strike">❌ My brother is more tall than me.</span></div><input type="text" data-q="g14" placeholder="✅ Your correction"></div>
    <div class="q-block"><div class="q-title">15. <span class="strike">❌ We arrived in the airport at Monday morning.</span></div><input type="text" data-q="g15" placeholder="✅ Your correction"></div>

    <div class="btn-row"><button class="btn" id="btnFinish">FINISH</button></div>
  </div>

  <!-- FINISH -->
  <div class="screen" id="screen-finish">
    <div class="score-screen">
      <h2 style="color:var(--gray);margin-bottom:0;">👏 Congratulations! ❤️‍🔥</h2>
      <p id="finishName" style="font-weight:700;color:var(--orange);margin:6px 0 0;"></p>
      <p style="max-width:520px;margin:14px auto;">You've officially survived the A1 English test 😎👏.<br>
      Sé que pudo estar difícil, pero no te asares, poco a poco vamos aprendiendo juntos 💪. Making mistakes is totally ok, es parte del proceso. Don't give up!</p>

      <div style="margin-top:26px;">
        <div style="font-weight:700;color:var(--gray);">👀 YOUR SCORE:</div>
        <div class="score-big" id="scoreBig">0%</div>
        <div class="score-sub" id="scoreSub"></div>
      </div>

      <div class="section-scores" id="sectionScores"></div>

      <div id="finishMsgWrap" class="finish-msg" style="max-width:560px;margin:0 auto;"></div>

      <div class="btn-row" id="finishBtnWrap"></div>
    </div>
  </div>

  <footer class="tiny">ARVA ENGLISH · clases@arvaenglish.com</footer>
</div>

<script>
const ANSWERS = {
  l1:["KEIKO"], l2:["JO6337"],
  l3:["ADVANCED ENGLISH STUDIES","ENGLISH STUDIES","ENGLISH"],
  l4:["5 MONTHS","20 WEEKS"],
  l5:["ABOUT 4 MONTHS","4 MONTHS"],
  l6:["B","D"], // multi
  l7:["SEAFOOD","FISH"], l8:["TENNIS"], l9:["THE TRAIN"],
  l10:["THIS AFTERNOON","IN THE AFTERNOON"],

  r1:["BRITISH"], r2:["BALLET"], r3:["TRUE"], r4:["TRUE"], r5:["FALSE"],
  r6:["B"], r7:["A"], r8:["B"], r9:["WORKED"], r10:["B"],

  g1:["A"], g2:["B"], g3:["B"], g4:["A"], g5:["B"],
  g6:["HAVEN'T SEEN","HAVE NOT SEEN"],
  g7:["ARE PLAYING"],
  g8:["VISITED"],
  g9a:["IN"], g9b:["AT"],
  g10:["THE MOST INTERESTING"],
  g11:["SHE USUALLY GOES TO THE GYM AFTER WORK"],
  g12:["I VISITED CARTAGENA LAST YEAR"],
  g13:["THEY HAVE LIVED IN THIS APARTMENT SINCE 2023"],
  g14:["MY BROTHER IS TALLER THAN ME"],
  g15:["WE ARRIVED AT THE AIRPORT ON MONDAY MORNING"]
};
const ALL_TEXT_Q = ["l1","l2","l3","l4","l5","l7","l8","l9","l10","r1","r2","r9","g6","g7","g8","g9a","g9b","g10","g11","g12","g13","g14","g15"];
const ALL_RADIO_Q = ["r3","r4","r5","r6","r7","r8","g1","g2","g3","g4","g5"];
const TOTAL_QUESTIONS = 35; // l1-10, r1-10, g1-15

let state = { name: "", correctness: {} };

function norm(s){
  return (s||"").toUpperCase().trim().replace(/[.,!?'’]/g,"").replace(/\s+/g," ");
}
function showScreen(id){
  document.querySelectorAll(".screen").forEach(s=>s.classList.remove("active"));
  document.getElementById(id).classList.add("active");
  window.scrollTo({top:0,behavior:"smooth"});
}

// --- Welcome ---
const nameInput = document.getElementById("nameInput");
const btnNameNext = document.getElementById("btnNameNext");
nameInput.addEventListener("input", ()=>{ btnNameNext.disabled = nameInput.value.trim().length===0; });
btnNameNext.addEventListener("click", ()=>{
  state.name = nameInput.value.trim();
  document.getElementById("helloName").textContent = state.name;
  showScreen("screen-intro");
});

// --- Intro / progress ---
document.getElementById("btnLetsGo").addEventListener("click", (e)=>{
  const btn = e.target;
  btn.disabled = true;
  const wrap = document.getElementById("progressWrap");
  const fill = document.getElementById("progressFill");
  wrap.classList.add("show");
  requestAnimationFrame(()=>{ fill.style.width = "100%"; });
  setTimeout(()=>{
    showScreen("screen-listening");
    btn.disabled = false;
    fill.style.width = "0%";
    wrap.classList.remove("show");
  }, 1300);
});

document.getElementById("btnToReading").addEventListener("click", ()=> showScreen("screen-reading"));
document.getElementById("btnToGrammar").addEventListener("click", ()=> showScreen("screen-grammar"));
document.getElementById("btnFinish").addEventListener("click", ()=>{
  gradeAll();
  renderFinish();
  showScreen("screen-finish");
});

function isCorrect(q, val){
  if(!val) return false;
  const key = ANSWERS[q];
  if(!key) return false;
  return key.includes(norm(val));
}

function gradeAll(){
  let correctness = {};

  ALL_TEXT_Q.forEach(q=>{
    const el = document.querySelector(`[data-q="${q}"]`);
    const val = el ? el.value : "";
    correctness[q] = isCorrect(q, val);
  });

  ALL_RADIO_Q.forEach(q=>{
    const el = document.querySelector(`input[name="${q}"]:checked`);
    const val = el ? el.value : "";
    correctness[q] = ANSWERS[q] ? ANSWERS[q].includes(val) : false;
  });

  // l6 multi-select checkbox: need exactly B and D checked
  const checked = Array.from(document.querySelectorAll('input[data-q="l6"]:checked')).map(i=>i.value);
  const need = ANSWERS.l6;
  correctness["l6"] = checked.length===need.length && need.every(v=>checked.includes(v));

  // g9 combined
  correctness["g9"] = correctness["g9a"] && correctness["g9b"];

  state.correctness = correctness;
}

const SECTION_IDS = {
  listening: ["l1","l2","l3","l4","l5","l6","l7","l8","l9","l10"],
  reading:   ["r1","r2","r3","r4","r5","r6","r7","r8","r9","r10"],
  grammar:   ["g1","g2","g3","g4","g5","g6","g7","g8","g9","g10","g11","g12","g13","g14","g15"]
};

function countCorrect(){
  return Object.values(SECTION_IDS).flat().reduce((sum,id)=> sum + (state.correctness[id] ? 1 : 0), 0);
}

function sectionScore(section){
  const ids = SECTION_IDS[section];
  const correct = ids.reduce((sum,id)=> sum + (state.correctness[id] ? 1 : 0), 0);
  return { correct, total: ids.length, pct: Math.round((correct/ids.length)*100) };
}

function renderFinish(){
  const correct = countCorrect();
  const pct = Math.round((correct/TOTAL_QUESTIONS)*100);
  document.getElementById("finishName").textContent = state.name ? state.name + " —" : "";
  document.getElementById("scoreBig").textContent = pct + "%";
  document.getElementById("scoreSub").textContent = correct + " / " + TOTAL_QUESTIONS + " correct";

  renderSectionScores();

  const msgWrap = document.getElementById("finishMsgWrap");
  const btnWrap = document.getElementById("finishBtnWrap");
  msgWrap.innerHTML = "";
  btnWrap.innerHTML = "";

  if(pct >= 70){
    msgWrap.innerHTML = `
      <p>Ya puedes entablar conversaciones de la vida real sin entrar en pánico 😅.</p>
      <p>Entiendes chisme sencillo, puedes contar cómo fue que te montaron cacho el año pasado y hasta chatear en inglés sin usar Google Translate… bueno, no tanto 😂.</p>
      <p><strong>¡Ya puedes defenderte! Estás listo para tu curso de A2 🙏🔥</strong></p>`;
    const a = document.createElement("a");
    a.href = "https://calendar.app.google/2mN1PasjdxCj9BEH6";
    a.target = "_blank";
    a.rel = "noopener";
    a.className = "btn";
    a.textContent = "Programa tu Speaking Test";
    btnWrap.appendChild(a);
  } else {
    msgWrap.innerHTML = `
      <p>Hey! Todo es un proceso… te caes, te levantas y sigues.</p>
      <p>Hay algunas cosas que estoy segura que sabes y tal vez no pusiste atención. ¡No worries, inténtalo de nuevo!</p>`;
    const btn = document.createElement("button");
    btn.className = "btn";
    btn.textContent = "Try again";
    btn.addEventListener("click", startReview);
    btnWrap.appendChild(btn);
  }
}

function renderSectionScores(){
  const labels = { listening:"🎧 Listening", reading:"📖 Reading", grammar:"🧠 Grammar" };
  const scores = {
    listening: sectionScore("listening"),
    reading: sectionScore("reading"),
    grammar: sectionScore("grammar")
  };
  const bestPct = Math.max(scores.listening.pct, scores.reading.pct, scores.grammar.pct);

  const wrap = document.getElementById("sectionScores");
  wrap.innerHTML = "";
  Object.keys(scores).forEach(key=>{
    const s = scores[key];
    const card = document.createElement("div");
    card.className = "section-score-card" + (s.pct === bestPct ? " best" : "");
    card.innerHTML = `
      <div class="ssc-label">${labels[key]}</div>
      <div class="ssc-value">${s.pct}%</div>
      <div class="ssc-frac">${s.correct} / ${s.total}</div>
    `;
    wrap.appendChild(card);
  });
}

// --- Review flow: lock correct answers, clear + highlight wrong ones ---
function startReview(){
  lockOrClear("l1");lockOrClear("l2");lockOrClear("l3");lockOrClear("l4");lockOrClear("l5");
  lockOrClear("l7");lockOrClear("l8");lockOrClear("l9");lockOrClear("l10");
  lockOrClear("r1");lockOrClear("r2");lockOrClear("r9");
  lockOrClear("g6");lockOrClear("g7");lockOrClear("g8");lockOrClear("g9a");lockOrClear("g9b");lockOrClear("g10");
  lockOrClear("g11");lockOrClear("g12");lockOrClear("g13");lockOrClear("g14");lockOrClear("g15");

  lockOrClearRadioGroup("r3");lockOrClearRadioGroup("r4");lockOrClearRadioGroup("r5");
  lockOrClearRadioGroup("r6");lockOrClearRadioGroup("r7");lockOrClearRadioGroup("r8");
  lockOrClearRadioGroup("g1");lockOrClearRadioGroup("g2");lockOrClearRadioGroup("g3");
  lockOrClearRadioGroup("g4");lockOrClearRadioGroup("g5");

  lockOrClearCheckboxGroup("l6");

  showScreen("screen-listening");
}

function markBadge(el, ok){
  const old = el.parentElement.querySelector(".locked-badge,.fix-badge");
  if(old) old.remove();
  const span = document.createElement("span");
  span.className = ok ? "locked-badge" : "fix-badge";
  span.textContent = ok ? "✓ correct" : "fix this";
  el.insertAdjacentElement("afterend", span);
}

function lockOrClear(q){
  const el = document.querySelector(`[data-q="${q}"]`);
  if(!el) return;
  const ok = state.correctness[q];
  if(ok){ el.disabled = true; markBadge(el, true); }
  else { el.value=""; el.disabled=false; markBadge(el, false); }
}

function lockOrClearRadioGroup(q){
  const radios = document.querySelectorAll(`input[name="${q}"]`);
  const ok = state.correctness[q];
  radios.forEach(r=>{
    const row = r.closest(".radio-row");
    row.classList.remove("correct","wrong");
    if(ok){
      r.disabled = true;
      if(r.checked) row.classList.add("correct");
    } else {
      r.checked = false;
      r.disabled = false;
    }
  });
}

function lockOrClearCheckboxGroup(q){
  const boxes = document.querySelectorAll(`input[data-q="${q}"]`);
  const ok = state.correctness[q];
  boxes.forEach(b=>{
    const row = b.closest(".checkbox-row");
    row.classList.remove("correct","wrong");
    if(ok){
      b.disabled = true;
      if(b.checked) row.classList.add("correct");
    } else {
      b.checked = false;
      b.disabled = false;
    }
  });
}
</script>
</body>
</html>
